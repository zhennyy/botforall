#!/usr/bin/env bash
# bfa — короткие команды для управления сайтом и ботами BotForAll
set -euo pipefail
ROOT=/opt/bots; DATA=/data; BK=/var/backups/botforall; U=bots
[ -f /etc/botforall.conf ] && . /etc/botforall.conf
ALL="coffeebot flowerbot radiatorbot assistant minicrm"
p() { (cd $ROOT && sudo -u $U -H pm2 "$@"); }
need() { [ -n "${1:-}" ] || { echo "Укажи бота: $ALL"; exit 1; }; [ -d $ROOT/$1 ] || { echo "Нет бота $1"; exit 1; }; }

case "${1:-help}" in
  env)     umask 077; need "${2:-}"; nano $ROOT/$2/.env; chown $U:$U $ROOT/$2/.env; chmod 600 $ROOT/$2/.env
           echo "Сохранено. Применить: bfa restart $2" ;;
  start)   need "${2:-}"; p start $ROOT/ecosystem.config.cjs --only "$2"; p save ;;
  stop)    need "${2:-}"; p stop "$2"; p save ;;
  restart) need "${2:-}"; p restart "$2" --update-env ;;
  logs)    need "${2:-}"; p logs "$2" --lines "${3:-80}" ;;
  status)  p ls; df -h / | tail -1; free -h | sed -n 2p ;;
  update)  # свежий код с GitHub для всех (данные в /data не трогаются)
           for d in site $ALL; do [ -d $ROOT/$d/.git ] || continue; echo "▶ $d"; sudo -u $U git -C $ROOT/$d pull --ff-only
             if [ $d = site ]; then (cd $ROOT/site && sudo -u $U npm ci && sudo -u $U npm run build)
             else (cd $ROOT/$d && if [ -f package-lock.json ]; then sudo -u $U npm ci --omit=dev; else sudo -u $U npm install --omit=dev; fi)
                  p describe $d >/dev/null 2>&1 && p restart $d --update-env; fi; done ;;
  backup)  # копия всех баз и файлов, хранится 14 дней
           umask 077; mkdir -p $BK; chmod 700 $BK; T=$(mktemp -d); cp -a $DATA/. $T/
           find $T -name '*.db' | while read -r f; do sqlite3 "${f/$T/$DATA}" ".backup '$f'"; done
           tar -czf $BK/data-$(date +%F).tar.gz -C $T .; rm -rf $T
           find $BK -name 'data-*.tar.gz' -mtime +14 -delete; ls -lh $BK | tail -3 ;;
  ssl)     D=${DOMAIN:?}; IP=$(curl -fsS https://ipv4.icanhazip.com); ARGS=""
           for h in $D www.$D coffee.$D fleur.$D radiator.$D crm.$D; do
             if [ "$(dig +short $h | tail -1)" = "$IP" ]; then ARGS="$ARGS -d $h"; else echo "⚠ $h ещё не указывает на $IP — пропускаю"; fi; done
           [ -n "$ARGS" ] || { echo "Ни один адрес не указывает на сервер — проверь DNS"; exit 1; }
           certbot --nginx --non-interactive --agree-tos --redirect -m "${EMAIL:?Нет EMAIL в /etc/botforall.conf}" $ARGS ;;
  *) cat <<H
bfa env <бот>       — открыть ключи бота (Ctrl+O, Enter — сохранить; Ctrl+X — выйти)
bfa start <бот>     — запустить бота (и автозапуск после перезагрузки)
bfa stop <бот>      — остановить
bfa restart <бот>   — перезапустить после смены ключей
bfa logs <бот>      — последние записи бота (выход: Ctrl+C)
bfa status          — кто запущен, сколько памяти и диска
bfa update          — обновить сайт и ботов с GitHub
bfa backup          — сделать резервную копию сейчас (ночью делается сама)
bfa ssl             — выпустить/обновить HTTPS-сертификаты
Боты: $ALL
H
  ;;
esac
